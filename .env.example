# Application Environment
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development_super_secret_jwt_key_at_least_32_chars_long

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forest_carbon_mrv?schema=public

# IPFS Pinata (Server-side only)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here
PINATA_JWT=your_pinata_jwt_token_here
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Web3 & Blockchain (Polygon Amoy / Sepolia / Hardhat Local)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Deployed Contract Addresses
NEXT_PUBLIC_CARBON_CREDIT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Server Minter Private Key (Authorized MINTER_ROLE on EcoCarbonCredit)
# Default Hardhat account #0 private key for local development:
MINTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
